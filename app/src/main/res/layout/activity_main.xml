<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF7E8">

    <LinearLayout
        android:id="@+id/contenido"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="28dp"
        android:layout_marginEnd="28dp"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/titulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/app_name"
            android:textColor="#4B3267"
            android:textSize="36sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <TextView
            android:id="@+id/personaje"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="20dp"
            android:text="@string/instruccion_inicial"
            android:textColor="#333333"
            android:textSize="24sp"
            android:textStyle="bold"
            android:minHeight="120dp"
            android:background="#FFFFFF"
            android:layout_marginBottom="28dp" />

        <Button
            android:id="@+id/btGenerarPersonaje"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/bt_generar_personaje"
            android:textSize="18sp"
            android:textAllCaps="false"
            android:padding="14dp"
            android:backgroundTint="#8C6BC4"
            android:textColor="#FFFFFF" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
